import { Button, LineEdit, ListView, ScrollView, Palette, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { App, Page, TabItem, GroupItem, EntryItem } from "types.slint";
import { FieldLabel, SectionTitle, CopyButton, ValueRow, PasswordRow } from "widgets.slint";

component StaleBadge {
    in property <length> font-size: 12px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            background: #ffebee;
            border-color: #d32f2f;
            border-width: 1px;
            border-radius: 10px;
            height: 24px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text { text: "✗ not working"; color: #c62828; font-size: root.font-size; vertical-alignment: center; }
            }
        }
    }
}

component TabBar {
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for tab[i] in App.tabs: Rectangle {
            property <bool> active: i == App.active-tab;
            background: active ? Palette.background : Palette.alternate-background;
            border-width: 1px;
            border-color: active ? Palette.accent-background : Palette.border;
            border-radius: 6px;
            height: 36px;
            TouchArea { clicked => { App.select-tab(i); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                Text {
                    text: tab.name;
                    font-size: 14px;
                    font-weight: active ? 700 : 400;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 28px;
                    border-radius: 4px;
                    background: lock-area.has-hover ? Palette.border : transparent;
                    Text { text: "🔒"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    lock-area := TouchArea { clicked => { App.lock-tab(i); } }
                }
            }
        }
        Button {
            text: "+";
            clicked => { App.page = Page.unlock; }
        }
    }
}

component GroupTree {
    callback request-add-group(parent-index: int);
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            FieldLabel { text: "GROUPS"; horizontal-stretch: 1; }
            Button {
                text: "+";
                clicked => { root.request-add-group(App.selected-group); }
            }
        }
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 6px;
            vertical-stretch: 1;
            ContextMenuArea {
                Menu {
                    MenuItem {
                        title: "Add group…";
                        activated => { root.request-add-group(App.selected-group); }
                    }
                }
                ListView {
                    for g[i] in App.groups: Rectangle {
                        height: 34px;
                        background: i == App.selected-group ? Palette.selection-background.with-alpha(0.35) : transparent;
                        border-radius: 4px;
                        TouchArea {
                            clicked => { App.select-group(i); }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                    App.select-group(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px + g.depth * 16px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                text: g.is-recycle-bin ? "🗑 " + g.name : g.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                                color: g.is-recycle-bin ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
                            }
                        }
                    }
                }
            }
        }
    }
}

component EntryList {
    VerticalLayout {
        spacing: 8px;
        search := LineEdit {
            placeholder-text: "Search all accounts…";
            font-size: 16px;
            text <=> App.search-text;
            init => { self.focus(); }
            edited(text) => { App.search-changed(text); }
            accepted => { if App.entries.length > 0 { App.select-entry(0); } }
        }
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 6px;
            vertical-stretch: 1;
            if App.entries.length == 0: Text {
                text: App.search-text == "" ? "No accounts in this group yet." : "Nothing matches.";
                color: Palette.foreground.with-alpha(0.6);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ListView {
                for e[i] in App.entries: Rectangle {
                    height: 58px;
                    background: i == App.selected-entry ? Palette.selection-background.with-alpha(0.35) : transparent;
                    border-radius: 4px;
                    TouchArea {
                        clicked => { App.select-entry(i); }
                        double-clicked => { App.select-entry(i); App.edit-entry(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            opacity: e.stale ? 0.5 : 1;
                            Text { text: e.title == "" ? "(untitled)" : e.title; font-size: 16px; font-weight: 600; overflow: elide; }
                            Text {
                                text: e.username != "" ? e.username : e.url;
                                font-size: 13px;
                                color: Palette.foreground.with-alpha(0.65);
                                overflow: elide;
                            }
                        }
                        if e.stale: StaleBadge { }
                    }
                }
            }
        }
    }
}

component DetailPane {
    Rectangle {
        background: Palette.alternate-background;
        border-radius: 6px;
        if !App.has-detail: Text {
            text: "Select an account to see its details.";
            color: Palette.foreground.with-alpha(0.6);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if App.has-detail: ScrollView {
            VerticalLayout {
                width: parent.visible-width;
                padding: 16px;
                spacing: 14px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: App.detail-title;
                        font-size: 22px;
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        opacity: App.detail-stale ? 0.6 : 1;
                    }
                    if App.detail-stale: StaleBadge { font-size: 13px; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Edit"; primary: true; clicked => { App.edit-entry(); } }
                    Button { text: App.detail-stale ? "Mark working" : "Mark not working"; clicked => { App.toggle-stale(); } }
                    Button { text: "Auto-Type"; clicked => { App.autotype-entry(); } }
                    Button { text: App.detail-in-bin ? "Delete permanently" : "Delete"; clicked => { App.delete-entry(); } }
                }

                ValueRow { label: "Username / email"; value: App.detail-username; }
                PasswordRow { value: App.detail-password; }

                if App.detail-url != "": VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: "Website"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: App.detail-url; font-size: 15px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Palette.accent-background; }
                        Button { text: "Open"; clicked => { App.open-url(App.detail-url); } }
                        CopyButton { value: App.detail-url; }
                    }
                }

                ValueRow { label: "Recovery PIN"; value: App.detail-pin; mono: true; }
                ValueRow { label: "Recovery phone"; value: App.detail-phone; }
                ValueRow { label: "Security questions"; value: App.detail-questions; wrap: true; }

                if App.detail-note-lines.length > 0: VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: "Notes"; }
                    Rectangle {
                        background: Palette.background;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            for line in App.detail-note-lines: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: line;
                                    font-size: 14px;
                                    font-family: App.notes-monospace ? App.mono-font : "";
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 44px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: copy-line.has-hover ? Palette.border : transparent;
                                    visible: line != "";
                                    Text { text: "copy"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; color: Palette.accent-background; }
                                    copy-line := TouchArea { clicked => { App.copy-text(line); } }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        FieldLabel { text: "Attachments"; horizontal-stretch: 1; }
                        Button { text: "Add file…"; clicked => { App.add-attachment(); } }
                    }
                    for name[i] in App.detail-attachments: HorizontalLayout {
                        spacing: 8px;
                        Text { text: name; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Button { text: "Save as…"; clicked => { App.save-attachment(i); } }
                        Button { text: "Remove"; clicked => { App.remove-attachment(i); } }
                    }
                }

                ValueRow { label: "Tags"; value: App.detail-tags; }
                FieldLabel { text: "Last changed " + App.detail-modified; }
            }
        }
    }
}

export component MainPage {
    property <int> add-group-parent: 0;

    add-group-popup := PopupWindow {
        x: (root.width - 360px) / 2;
        y: 120px;
        width: 360px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 8px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                SectionTitle { text: "New group"; }
                FieldLabel { text: App.groups.length > 0 ? "Inside " + App.groups[root.add-group-parent].name : ""; }
                group-name := LineEdit {
                    placeholder-text: "Group name";
                    init => { self.focus(); }
                    accepted(text) => {
                        if text != "" { App.add-group(root.add-group-parent, text); }
                        add-group-popup.close();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { add-group-popup.close(); } }
                    Button {
                        text: "Add";
                        primary: true;
                        clicked => {
                            if group-name.text != "" { App.add-group(root.add-group-parent, group-name.text); }
                            add-group-popup.close();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            TabBar { horizontal-stretch: 1; }
            Button { text: "Settings"; clicked => { App.open-settings(); } }
            Button {
                text: "+ Add account";
                primary: true;
                clicked => { App.add-account(); }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            GroupTree {
                width: 220px;
                request-add-group(parent-index) => {
                    root.add-group-parent = parent-index;
                    add-group-popup.show();
                }
            }
            EntryList { horizontal-stretch: 1; min-width: 300px; }
            DetailPane { horizontal-stretch: 1.4; min-width: 360px; }
        }
    }
}
