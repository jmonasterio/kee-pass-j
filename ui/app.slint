import { Button, ListView, Palette } from "std-widgets.slint";
import { App, Page } from "types.slint";
import { ErrorBanner, SectionTitle, FieldLabel } from "widgets.slint";
import { UnlockPage } from "unlock.slint";
import { MainPage } from "main_page.slint";
import { EntryForm } from "entry_form.slint";
import { SettingsPage } from "settings_page.slint";

export { App, Page, TabItem, RecentItem, GroupItem, EntryItem, CustomFieldItem, ChooserItem } from "types.slint";

export component AppWindow inherits Window {
    title: "KeePassJ";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 560px;
    default-font-size: 14px;
    background: Palette.background;

    /// Puts `text` on the system clipboard through a hidden TextInput.
    public function copy-to-clipboard(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    VerticalLayout {
        ErrorBanner {
            message: App.save-error;
            retry => { App.retry-save(); }
        }
        Rectangle {
            vertical-stretch: 1;
            if App.page == Page.unlock: UnlockPage { }
            if App.page == Page.main: MainPage { }
            if App.page == Page.add-account: EntryForm { edit-mode: false; }
            if App.page == Page.edit-entry: EntryForm { edit-mode: true; }
            if App.page == Page.settings: SettingsPage { }
        }
    }

    // Auto-Type chooser: several entries match the active window.
    if App.chooser-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { App.cancel-chooser(); } }
        Rectangle {
            width: 520px;
            height: min(root.height - 80px, 120px + App.chooser-items.length * 56px);
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;
            TouchArea { }
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.Escape { App.cancel-chooser(); return accept; }
                    if event.text == Key.Return && App.chooser-items.length > 0 { App.choose-autotype(0); return accept; }
                    reject
                }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    SectionTitle { text: "Which account?"; }
                    FieldLabel { text: "Several accounts match the active window. Pick one to type."; }
                    ListView {
                        vertical-stretch: 1;
                        for item[i] in App.chooser-items: Rectangle {
                            height: 52px;
                            border-radius: 6px;
                            background: area.has-hover ? Palette.selection-background.with-alpha(0.35) : transparent;
                            area := TouchArea { clicked => { App.choose-autotype(i); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text { text: item.title; font-size: 15px; font-weight: 600; overflow: elide; }
                                    Text { text: item.username; font-size: 13px; color: Palette.foreground.with-alpha(0.65); overflow: elide; }
                                }
                                Text { text: item.db; font-size: 12px; color: Palette.foreground.with-alpha(0.5); vertical-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button { text: "Cancel"; clicked => { App.cancel-chooser(); } }
                    }
                }
            }
        }
    }

    // Short-lived toast message.
    if App.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 28px;
        width: toast-layout.preferred-width;
        height: toast-layout.preferred-height;
        background: #323232;
        border-radius: 8px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        toast-layout := HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 10px;
            padding-bottom: 10px;
            Text { text: App.toast; color: white; font-size: 14px; }
        }
    }
}
