// Shared data types and the `App` global that carries every property and callback
// between the Slint pages and src/main.rs.

export enum Page { unlock, main, add-account, edit-entry, settings }

export struct TabItem { name: string, path: string }
export struct RecentItem { name: string, path: string, missing: bool, keyfile: string }
export struct GroupItem { name: string, depth: int, is-recycle-bin: bool }
export struct EntryItem { title: string, username: string, url: string, stale: bool }
export struct CustomFieldItem { key: string, value: string, protected: bool }
export struct ChooserItem { title: string, username: string, db: string }

export global App {
    // ---- shell ----
    in-out property <Page> page: Page.unlock;
    in property <string> mono-font: "monospace";
    in property <string> save-error;
    in property <string> toast;
    callback retry-save();
    callback copy-text(text: string);
    callback open-url(url: string);

    // ---- unlock / picker ----
    in property <[RecentItem]> recent;
    in-out property <int> selected-recent: 0;
    in property <string> unlock-error;
    in property <bool> creating: false;
    in property <string> new-db-path;
    in property <bool> has-open-dbs: false;
    callback unlock(index: int, password: string);
    callback browse-open();
    callback browse-new();
    callback create-database(password: string, confirm: string);
    callback cancel-create();
    callback forget-recent(index: int);
    callback choose-keyfile(index: int);
    callback clear-keyfile(index: int);
    callback back-to-main();

    // ---- main page ----
    in property <[TabItem]> tabs;
    in-out property <int> active-tab: 0;
    in property <[GroupItem]> groups;
    in-out property <int> selected-group: 0;
    in property <[EntryItem]> entries;
    in-out property <int> selected-entry: -1;
    in-out property <string> search-text;
    callback select-tab(index: int);
    callback lock-tab(index: int);
    callback select-group(index: int);
    callback add-group(parent-index: int, name: string);
    callback select-entry(index: int);
    callback search-changed(text: string);
    callback add-account();
    callback open-settings();

    // ---- detail pane ----
    in property <bool> has-detail: false;
    in property <string> detail-title;
    in property <string> detail-username;
    in property <string> detail-password;
    in property <string> detail-url;
    in property <string> detail-pin;
    in property <string> detail-phone;
    in property <string> detail-questions;
    in property <[string]> detail-note-lines;
    in property <[string]> detail-attachments;
    in property <string> detail-tags;
    in property <string> detail-modified;
    in property <bool> detail-stale;
    in property <bool> detail-in-bin;
    in property <bool> notes-monospace;
    callback edit-entry();
    callback toggle-stale();
    callback delete-entry();
    callback autotype-entry();
    callback add-attachment();
    callback save-attachment(index: int);
    callback remove-attachment(index: int);

    // ---- add / edit form ----
    in-out property <string> form-title;
    in-out property <string> form-url;
    in-out property <string> form-username;
    in-out property <string> form-password;
    in-out property <string> form-pin;
    in-out property <string> form-phone;
    in-out property <string> form-questions;
    in-out property <string> form-notes;
    in-out property <string> form-tags;
    in-out property <string> form-autotype-sequence;
    in-out property <string> form-windows;          // one pattern per line
    in-out property <int> form-group-index: 0;
    in property <[string]> form-groups;
    in property <[CustomFieldItem]> form-custom;
    in property <string> duplicate-title;           // non-empty: an entry for this site already exists
    in-out property <int> gen-length: 16;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: false;
    callback regenerate();
    callback site-edited();
    callback save-form(replace: bool);
    callback cancel-form();
    callback custom-add();
    callback custom-remove(index: int);
    callback custom-edited(index: int, key: string, value: string, protected: bool);

    // ---- settings ----
    in-out property <string> settings-hotkey;
    in-out property <string> settings-sequence;
    in-out property <bool> settings-reopen-last;
    in-out property <bool> settings-notes-monospace;
    in-out property <int> settings-gen-length: 16;
    in-out property <bool> settings-gen-digits;
    in-out property <bool> settings-gen-symbols;
    in-out property <bool> settings-gen-uppercase;
    in-out property <bool> settings-gen-exclude-ambiguous;
    in property <string> settings-backup-dir;
    in property <string> settings-error;
    callback save-settings();
    callback cancel-settings();
    callback open-backup-folder();

    // ---- auto-type chooser ----
    in property <bool> chooser-visible: false;
    in property <[ChooserItem]> chooser-items;
    callback choose-autotype(index: int);
    callback cancel-chooser();
}
