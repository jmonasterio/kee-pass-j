import { Button, Palette } from "std-widgets.slint";
import { App } from "types.slint";

export component FieldLabel inherits Text {
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.65);
    vertical-alignment: center;
}

export component SectionTitle inherits Text {
    font-size: 20px;
    font-weight: 600;
    color: Palette.foreground;
}

export component PageTitle inherits Text {
    font-size: 26px;
    font-weight: 700;
    color: Palette.foreground;
}

export component CopyButton inherits Button {
    in property <string> value;
    text: "Copy";
    enabled: value != "";
    clicked => { App.copy-text(root.value); }
}

/// Read-only value with a copy button, used by the detail pane.
export component ValueRow {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> wrap: false;
    visible: value != "";
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: root.label; }
        HorizontalLayout {
            spacing: 8px;
            alignment: stretch;
            Text {
                text: root.value;
                font-size: 15px;
                font-family: root.mono ? App.mono-font : "";
                vertical-alignment: center;
                wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            CopyButton { value: root.value; }
        }
    }
}

/// Large monospace password display with reveal toggle and copy.
export component PasswordRow {
    in property <string> value;
    in-out property <bool> revealed: false;
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: "Password"; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                background: Palette.alternate-background;
                border-radius: 6px;
                min-height: 40px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.revealed ? root.value : (root.value == "" ? "" : "••••••••••••");
                        font-size: 18px;
                        font-family: App.mono-font;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Button {
                text: root.revealed ? "Hide" : "Show";
                clicked => { root.revealed = !root.revealed; }
            }
            CopyButton { value: root.value; }
        }
    }
}

/// Persistent red banner shown when a save fails.
export component ErrorBanner inherits Rectangle {
    in property <string> message;
    callback retry();
    visible: message != "";
    background: #c62828;
    height: self.visible ? layout.preferred-height : 0px;
    layout := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Text {
            text: "Save failed: " + root.message;
            color: white;
            font-size: 14px;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        Button { text: "Retry"; clicked => { root.retry(); } }
    }
}
